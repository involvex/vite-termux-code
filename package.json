{
	"name": "@involvex/vite-termux-code",
	"version": "0.1.0",
	"private": true,
	"author": "involvex",
	"type": "module",
	"bin": {
		"td-code": "./dist/cli.js"
	},
	"scripts": {
		"prebuild": "bun run format && bun check && bun lint:fix",
		"build": "tsc -b && vite build && bun build ./server/cli.ts --outfile ./dist/cli.js --target bun && bun run build:ui",
		"build:ui": "vite build",
		"dev": "concurrently \"vite --port 4444 --host 0.0.0.0\" \"bun --watch ./server/cli.ts . --port 4445 --host 127.0.0.1 --no-auth\"",
		"format": "prettier . --write",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"preview": "concurrently \"vite preview\" \"bun --watch ./server/cli.ts . --port 4445 --host 127.0.0.1 --no-auth\"",
		"serve": "bun ./dist/cli.js",
		"smoke": "bun run ./scripts/smoke.ts",
		"test": "bun test",
		"typecheck": "tsc -b --noEmit"
	},
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@codemirror/autocomplete": "^6.19.0",
		"@codemirror/commands": "^6.10.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.9",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.1",
		"@codemirror/lang-python": "^6.2.0",
		"@codemirror/lang-yaml": "^6.1.2",
		"@codemirror/language": "^6.12.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.5.11",
		"@codemirror/state": "^6.5.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.38.1",
		"@novnc/novnc": "^1.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"chokidar": "^4.0.3",
		"codemirror": "^6.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ws": "^8.18.3",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@involvex/prettier-config": "^0.0.6",
		"@types/bun": "^1.3.4",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "10.0.6",
		"oxlint": "^1.81.0",
		"prettier": "^3.9.10",
		"typescript": "~5.9.3",
		"typescript-language-server": "^6.0.2",
		"vite": "^8.3.0"
	}
}
